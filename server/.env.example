NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hirelane
CLIENT_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Number of trusted reverse proxies; leave 0 for direct connections.
TRUST_PROXY=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
# Choose a currently available model in your Gemini account.
GEMINI_MODEL=gemini-2.5-flash
# Used ONLY by the explicit development seed command. At least 12 characters.
SEED_PASSWORD=
